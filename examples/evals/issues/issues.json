        { "mcp_server_url": "http://localhost:8080/github/mcp", "tool_name": "list_issues", "parameters": { "owner": "github", "repo": "github-mcp-server", "state": "OPEN" } }
      ],
      "order_dependent_matching": false,
      "available_mcp_servers": ["http://localhost:8080/github/mcp"]
