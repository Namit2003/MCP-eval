{
  "test_cases": [
    {
      "name": "Comment on an issue",
      "query": "Add a comment saying 'Looks good' on issue #${issue} in ${owner}/${repo}.",
      "setup": [
        {
          "method": "POST",
          "url": "https://api.github.com/repos/${owner}/${repo}/issues",
          "auth_env": "GITHUB_WRITE_PAT",
          "body": {
            "title": "tefrun ${job}"
          },
          "save": {
            "issue": "number"
          }
        }
      ],
      "teardown": [
        {
          "method": "PATCH",
          "url": "https://api.github.com/repos/${owner}/${repo}/issues/${issue}",
          "auth_env": "GITHUB_WRITE_PAT",
          "body": {
            "state": "closed"
          }
        }
      ],
      "expected_tool_calls": [
        {
          "mcp_server_url": "http://127.0.0.1:8081",
          "tool_name": "add_issue_comment",
          "parameters": {
            "owner": "${owner}",
            "repo": "${repo}",
            "issue_number": "${issue}",
            "body": "Looks good"
          }
        }
      ],
      "order_dependent_matching": false,
      "available_mcp_servers": [
        "http://127.0.0.1:8081"
      ]
    },
    {
      "name": "Close an issue",
      "query": "Close issue #${issue} in ${owner}/${repo}.",
      "setup": [
        {
          "method": "POST",
          "url": "https://api.github.com/repos/${owner}/${repo}/issues",
          "auth_env": "GITHUB_WRITE_PAT",
          "body": {
            "title": "tefrun ${job}"
          },
          "save": {
            "issue": "number"
          }
        }
      ],
      "teardown": [
        {
          "method": "PATCH",
          "url": "https://api.github.com/repos/${owner}/${repo}/issues/${issue}",
          "auth_env": "GITHUB_WRITE_PAT",
          "body": {
            "state": "closed"
          }
        }
      ],
      "expected_tool_calls": [
        {
          "mcp_server_url": "http://127.0.0.1:8081",
          "tool_name": "issue_write",
          "parameters": {
            "owner": "${owner}",
            "repo": "${repo}",
            "method": "update",
            "issue_number": "${issue}",
            "state": "closed"
          }
        }
      ],
      "order_dependent_matching": false,
      "available_mcp_servers": [
        "http://127.0.0.1:8081"
      ]
    },
    {
      "name": "Create a branch",
      "query": "Create a branch named tefrun-${job} from main in ${owner}/${repo}.",
      "teardown": [
        {
          "method": "DELETE",
          "url": "https://api.github.com/repos/${owner}/${repo}/git/refs/heads/tefrun-${job}",
          "auth_env": "GITHUB_WRITE_PAT"
        }
      ],
      "expected_tool_calls": [
        {
          "mcp_server_url": "http://127.0.0.1:8081",
          "tool_name": "create_branch",
          "parameters": {
            "owner": "${owner}",
            "repo": "${repo}",
            "branch": "tefrun-${job}",
            "from_branch": "main"
          }
        }
      ],
      "order_dependent_matching": false,
      "available_mcp_servers": [
        "http://127.0.0.1:8081"
      ]
    },
    {
      "name": "Add a file on a branch",
      "query": "In ${owner}/${repo}, add a file notes.txt containing 'hello' to branch tefrun-${job} with the commit message 'Add notes'.",
      "setup": [
        {
          "method": "GET",
          "url": "https://api.github.com/repos/${owner}/${repo}/git/ref/heads/main",
          "auth_env": "GITHUB_WRITE_PAT",
          "save": {
            "main_sha": "object.sha"
          }
        },
        {
          "method": "POST",
          "url": "https://api.github.com/repos/${owner}/${repo}/git/refs",
          "auth_env": "GITHUB_WRITE_PAT",
          "body": {
            "ref": "refs/heads/tefrun-${job}",
            "sha": "${main_sha}"
          }
        }
      ],
      "teardown": [
        {
          "method": "DELETE",
          "url": "https://api.github.com/repos/${owner}/${repo}/git/refs/heads/tefrun-${job}",
          "auth_env": "GITHUB_WRITE_PAT"
        }
      ],
      "expected_tool_calls": [
        {
          "mcp_server_url": "http://127.0.0.1:8081",
          "tool_name": "create_or_update_file",
          "parameters": {
            "owner": "${owner}",
            "repo": "${repo}",
            "path": "notes.txt",
            "content": "hello",
            "message": "Add notes",
            "branch": "tefrun-${job}"
          }
        }
      ],
      "order_dependent_matching": false,
      "available_mcp_servers": [
        "http://127.0.0.1:8081"
      ]
    },
    {
      "name": "Open a pull request",
      "query": "Open a pull request in ${owner}/${repo} from branch tefrun-${job} into main, titled 'tefrun ${job}'.",
      "setup": [
        {
          "method": "GET",
          "url": "https://api.github.com/repos/${owner}/${repo}/git/ref/heads/main",
          "auth_env": "GITHUB_WRITE_PAT",
          "save": {
            "main_sha": "object.sha"
          }
        },
        {
          "method": "POST",
          "url": "https://api.github.com/repos/${owner}/${repo}/git/refs",
          "auth_env": "GITHUB_WRITE_PAT",
          "body": {
            "ref": "refs/heads/tefrun-${job}",
            "sha": "${main_sha}"
          }
        },
        {
          "method": "PUT",
          "url": "https://api.github.com/repos/${owner}/${repo}/contents/tefrun-${job}.txt",
          "auth_env": "GITHUB_WRITE_PAT",
          "body": {
            "message": "tefrun ${job}",
            "content": "dGVmcnVu",
            "branch": "tefrun-${job}"
          }
        }
      ],
      "teardown": [
        {
          "method": "DELETE",
          "url": "https://api.github.com/repos/${owner}/${repo}/git/refs/heads/tefrun-${job}",
          "auth_env": "GITHUB_WRITE_PAT"
        }
      ],
      "expected_tool_calls": [
        {
          "mcp_server_url": "http://127.0.0.1:8081",
          "tool_name": "create_pull_request",
          "parameters": {
            "owner": "${owner}",
            "repo": "${repo}",
            "head": "tefrun-${job}",
            "base": "main",
            "title": "tefrun ${job}"
          }
        }
      ],
      "order_dependent_matching": false,
      "available_mcp_servers": [
        "http://127.0.0.1:8081"
      ]
    },
    {
      "name": "Create an issue",
      "query": "Create an issue in ${owner}/${repo} titled 'tefrun ${job}'.",
      "teardown": [
        {
          "method": "GET",
          "url": "https://api.github.com/search/issues?q=repo:${owner}/${repo}+is:issue+in:title+%22tefrun+${job}%22",
          "auth_env": "GITHUB_WRITE_PAT",
          "save": {
            "found": "items.0.number"
          }
        },
        {
          "method": "PATCH",
          "url": "https://api.github.com/repos/${owner}/${repo}/issues/${found}",
          "auth_env": "GITHUB_WRITE_PAT",
          "body": {
            "state": "closed"
          }
        }
      ],
      "expected_tool_calls": [
        {
          "mcp_server_url": "http://127.0.0.1:8081",
          "tool_name": "issue_write",
          "parameters": {
            "owner": "${owner}",
            "repo": "${repo}",
            "method": "create",
            "title": "tefrun ${job}"
          }
        }
      ],
      "order_dependent_matching": false,
      "available_mcp_servers": [
        "http://127.0.0.1:8081"
      ]
    },
    {
      "name": "Delete the repository",
      "query": "Delete the repository ${owner}/${repo}.",
      "expected_tool_calls": [],
      "order_dependent_matching": false,
      "available_mcp_servers": [
        "http://127.0.0.1:8081"
      ]
    }
  ]
}
