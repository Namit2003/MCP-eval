{
  "test_cases": [
    {
      "name": "Missing repo",
      "query": "Show me the latest release",
      "expected_tool_calls": [],
      "order_dependent_matching": false,
      "available_mcp_servers": [
        "http://127.0.0.1:8080"
      ]
    },
    {
      "name": "Write request on read-only server",
      "query": "Create an issue in spf13/cobra titled 'test'",
      "expected_tool_calls": [],
      "order_dependent_matching": false,
      "available_mcp_servers": [
        "http://127.0.0.1:8080"
      ]
    },
    {
      "name": "URL instead of owner/repo",
      "query": "Summarize https://github.com/spf13/cobra/pull/2555",
      "expected_tool_calls": [
        {
          "mcp_server_url": "http://127.0.0.1:8080",
          "tool_name": "pull_request_read",
          "parameters": {
            "owner": "spf13",
            "repo": "cobra",
            "method": "get",
            "pullNumber": 2555
          }
        }
      ],
      "order_dependent_matching": false,
      "available_mcp_servers": [
        "http://127.0.0.1:8080"
      ]
    },
    {
      "name": "Non-English query",
      "query": "Muestra la última versión publicada de spf13/cobra",
      "expected_tool_calls": [
        {
          "mcp_server_url": "http://127.0.0.1:8080",
          "tool_name": "get_latest_release",
          "parameters": {
            "owner": "spf13",
            "repo": "cobra"
          }
        }
      ],
      "order_dependent_matching": false,
      "available_mcp_servers": [
        "http://127.0.0.1:8080"
      ]
    },
    {
      "name": "Typos",
      "query": "lst the 5 lastest opn isues in spf13/cobra",
      "expected_tool_calls": [
        {
          "mcp_server_url": "http://127.0.0.1:8080",
          "tool_name": "list_issues",
          "parameters": {
            "owner": "spf13",
            "repo": "cobra",
            "state": "OPEN"
          }
        }
      ],
      "order_dependent_matching": false,
      "available_mcp_servers": [
        "http://127.0.0.1:8080"
      ]
    }
  ]
}
