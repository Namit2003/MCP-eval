{
  "test_cases": [
    {
      "name": "Newest PR files",
      "query": "Which files does the newest open pull request in spf13/cobra change?",
      "expected_tool_calls": [
        {
          "mcp_server_url": "http://127.0.0.1:8080",
          "tool_name": "list_pull_requests",
          "parameters": {
            "owner": "spf13",
            "repo": "cobra",
            "state": "open"
          }
        },
        {
          "mcp_server_url": "http://127.0.0.1:8080",
          "tool_name": "pull_request_read",
          "parameters": {
            "owner": "spf13",
            "repo": "cobra",
            "method": "get_files"
          }
        }
      ],
      "order_dependent_matching": true,
      "available_mcp_servers": [
        "http://127.0.0.1:8080"
      ]
    },
